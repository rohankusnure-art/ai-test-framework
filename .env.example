# --- LLM provider ---
LLM_PROVIDER=openai              # "openai" or "huggingface"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
HUGGINGFACE_MODEL=bigcode/starcoder2-7b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Storage ---
# Local/dev/CI default (zero setup):
DATABASE_URL=sqlite:///./ai_test_framework.db
# Production example (Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ai_test_framework
DB_POOL_SIZE=5
DB_POOL_TIMEOUT_SECONDS=10

# --- Generation / execution ---
GENERATED_TESTS_DIR=generated_tests
MAX_EDGE_CASES_PER_FUNCTION=6
TEST_EXECUTION_TIMEOUT_SECONDS=120
